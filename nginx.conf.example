# ════════════════════════════════════════════════════════════
# Tara Astro Vision — Nginx Reverse-Proxy Configuration
# Place this file at: /etc/nginx/sites-available/taraastrovision
# Then: sudo ln -s /etc/nginx/sites-available/taraastrovision /etc/nginx/sites-enabled/
# Then: sudo nginx -t && sudo systemctl reload nginx
# ════════════════════════════════════════════════════════════

server {
    listen 80;
    server_name www.taraastrovision.com taraastrovision.com;

    # Redirect all HTTP → HTTPS
    return 301 https://www.taraastrovision.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.taraastrovision.com taraastrovision.com;

    # ── SSL (managed by Certbot/Let's Encrypt) ─────────────
    ssl_certificate     /etc/letsencrypt/live/www.taraastrovision.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.taraastrovision.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Redirect bare domain → www
    if ($host = taraastrovision.com) {
        return 301 https://www.taraastrovision.com$request_uri;
    }

    # ── Security headers ────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Proxy ALL requests to FastAPI ──────────────────────
    # FastAPI serves both the static frontend AND all /api/* routes.
    # Homam SPA fallback is implemented in main.py (/homam/<slug> → homam/index.html)
    # and does not need a separate nginx try_files rule when proxying everything.
    # Production today may be IIS/Plesk static hosting instead: upload the /homam
    # folder (including per-slug index.html copies and web.config) to the site root.
    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        # Large body for PDF base64 uploads in booking confirmation
        client_max_body_size 20M;
    }

    # ── Razorpay webhook (no buffering, fast path) ──────────
    location /api/payment/webhook {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        client_max_body_size 1M;
    }

    # ── Health check (fast, no logging) ────────────────────
    location = /api/health {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        access_log         off;
    }
}
