# ════════════════════════════════════════════════════
# Tara Astro Vision — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ════════════════════════════════════════════════════

# ── JWT Secret (REQUIRED in production) ─────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
JWT_SECRET=your_strong_random_jwt_secret_here

# ── Razorpay (REQUIRED for payments) ────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Razorpay Webhook Secret (REQUIRED for webhooks) ──
# Set this after creating a webhook in Razorpay Dashboard
# Razorpay Dashboard → Settings → Webhooks → Create
# Events to enable: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (choose ONE option) ────────────────────────

# Option 1: Resend (recommended — free 100 emails/day)
# Sign up at https://resend.com, get API key from dashboard
RESEND_API_KEY=re_your_api_key_here

# Option 2: Gmail SMTP
# 1. Enable 2FA on Google account
# 2. Create App Password: https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=taraastrovision123@gmail.com
# SMTP_PASS=your_16_char_app_password

# ── Admin account bootstrap (new database only) ──────
# Set once before the first production start. Only info@taraastrovision.com
# is accepted by the admin portal. Existing admin records are not overwritten.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_unique_password

# ── CORS Origins (comma-separated, no spaces) ────────
# Keep only the origins you use. Local development origins are included here.
CORS_ORIGINS=https://www.taraastrovision.com,https://taraastrovision.com,http://localhost:5500,http://127.0.0.1:5500

# ── Database ─────────────────────────────────────────
# Local default: jyotisha.db beside main.py.
# Production: point at the hosting provider's persistent disk mount.
# Render blueprint: /var/data/jyotisha.db
# DATABASE_URL=/var/data/jyotisha.db

# ── Safety Limits ────────────────────────────────────
# Maximum order value in paise (default: ₹10 lakh = 100000000 paise)
# MAX_ORDER_PAISE=100000000
# LOG_LEVEL=INFO