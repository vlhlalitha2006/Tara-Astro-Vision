# Email Configuration - REQUIRED for booking notifications
# Copy this file to .env and fill in your values

# Option 1: Gmail SMTP (Use taraastrovision123@gmail.com)
# 1. Enable 2FA on your Google account
# 2. Create App Password: https://support.google.com/accounts/answer/185833
# 3. Use the 16-character password below
SMTP_PASS=your_16_char_app_password

# Option 2: Resend (Alternative - free 100 emails/day)
# Sign up at https://resend.com, get API key from dashboard
# RESEND_API_KEY=re_your_api_key_here

# Optional overrides (defaults work for Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=taraastrovision123@gmail.com
